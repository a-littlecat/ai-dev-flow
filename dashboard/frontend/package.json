{
  "name": "ai-dev-flow-dashboard-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "description": "Read-only local task relationship dashboard frontend (DASHBOARD-FE-001). Consumes only the versioned dashboard/contracts v1 API.",
  "scripts": {
    "codegen": "node scripts/generate-types.mjs",
    "codegen:check": "node scripts/generate-types.mjs --check",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "test": "npm run typecheck && npm run lint && npm run test:unit",
    "verify": "npm run codegen:check && npm run test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.0",
    "@types/node": "^22.10.0",
    "eslint": "^10.8.0",
    "jsdom": "^25.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
