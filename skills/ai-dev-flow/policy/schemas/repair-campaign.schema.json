{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-policy-schema-version": "adf/repair-campaign/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repair"],
  "properties": {
    "schema_version": {"const": "adf/repair-campaign/v1"},
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repair_round_definition", "non_counting_actions", "chain_identity_fields", "ledger_schema", "evidence_trust_boundary", "record_only_finding", "base_auto_rounds", "autonomous_max_rounds", "history", "required_true_fields", "required_false_fields", "round_3_progress", "task_change_resets_budget", "model_change_resets_budget", "post_stop", "campaign", "mechanical_decisions", "promotion_decisions", "promotion_requires_trusted_orchestrator", "eligible_modes"],
      "properties": {
        "repair_round_definition": {"enum": ["patch_to_next_independent_review"]},
        "non_counting_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["diagnostic_evidence_only", "record_only_correction", "review_only", "task_or_board_receipt_sync", "test_rerun_without_patch", "ua_without_patch"]}},
        "chain_identity_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["repair_chain_id", "finding_ids", "closure_contract_hash", "allowed_files_hash"]}},
        "ledger_schema": {"type": "string", "minLength": 1},
        "evidence_trust_boundary": {"enum": ["ledger_is_untrusted_trusted_context_is_supplied_by_project_or_harness"]},
        "record_only_finding": {
          "type": "object", "additionalProperties": false,
          "required": ["default_severity", "p1_only_if"],
          "properties": {
            "default_severity": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["P0", "P1", "P2", "P3"]}},
            "p1_only_if": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["can_authorize_unsafe_action", "can_hide_blocking_finding"]}}
          }
        },
        "base_auto_rounds": {"type": "integer", "minimum": 1},
        "autonomous_max_rounds": {"type": "integer", "minimum": 1},
        "history": {
          "type": "object", "additionalProperties": false,
          "required": ["attempt_count_source", "receipt_hash_algorithm", "require_history_anchor", "require_trusted_context", "trusted_context_schema", "require_independent_review_receipt_after_each_attempt"],
          "properties": {
            "attempt_count_source": {"enum": ["validated_receipt_chain"]},
            "receipt_hash_algorithm": {"enum": ["sha256_canonical_json"]},
            "require_history_anchor": {"const": true},
            "require_trusted_context": {"const": true},
            "trusted_context_schema": {"type": "string", "minLength": 1},
            "require_independent_review_receipt_after_each_attempt": {"const": true}
          }
        },
        "required_true_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["dependencies_frozen", "authority_frozen", "root_cause_known", "reviewer_capable", "repairer_capable", "within_cost_boundary"]}, "allOf": [{"contains": {"const": "dependencies_frozen"}}, {"contains": {"const": "authority_frozen"}}, {"contains": {"const": "root_cause_known"}}, {"contains": {"const": "reviewer_capable"}}, {"contains": {"const": "repairer_capable"}}, {"contains": {"const": "within_cost_boundary"}}]},
        "required_false_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["external_side_effect"]}, "allOf": [{"contains": {"const": "external_side_effect"}}]},
        "round_3_progress": {
          "type": "object", "additionalProperties": false,
          "required": ["source", "require_red_to_green", "forbid_green_to_red", "forbid_new_blocking_findings", "severity_must_not_increase", "evidence_coverage_must_strictly_increase", "round_3_target_required"],
          "properties": {
            "source": {"enum": ["latest_independent_review_receipt"]},
            "require_red_to_green": {"const": true},
            "forbid_green_to_red": {"const": true},
            "forbid_new_blocking_findings": {"const": true},
            "severity_must_not_increase": {"const": true},
            "evidence_coverage_must_strictly_increase": {"const": true},
            "round_3_target_required": {"const": true}
          }
        },
        "task_change_resets_budget": {"const": false},
        "model_change_resets_budget": {"const": false},
        "post_stop": {
          "type": "object", "additionalProperties": false,
          "required": ["state", "mode", "ai_repair_allowed_with_explicit_authority", "manual_implementation_required", "default_authorized_attempts", "authority_source", "authority_must_bind", "independent_review_after_each_attempt", "history_resets", "failure_decision"],
          "properties": {
            "state": {"enum": ["UserDecisionRequired", "Blocked"]},
            "mode": {"enum": ["EscalatedRepair"]},
            "ai_repair_allowed_with_explicit_authority": {"const": true},
            "manual_implementation_required": {"const": false},
            "default_authorized_attempts": {"type": "integer", "minimum": 1},
            "authority_source": {"enum": ["trusted_context_attested_chain_bound_authority_receipt"]},
            "authority_must_bind": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["repair_chain_digest", "closure_contract_hash", "allowed_files_hash", "target_finding_ids", "authorized_attempt_ids"]}, "allOf": [{"contains": {"const": "repair_chain_digest"}}, {"contains": {"const": "closure_contract_hash"}}, {"contains": {"const": "allowed_files_hash"}}, {"contains": {"const": "target_finding_ids"}}, {"contains": {"const": "authorized_attempt_ids"}}]},
            "independent_review_after_each_attempt": {"const": true},
            "history_resets": {"const": false},
            "failure_decision": {"enum": ["Stop", "UserDecisionRequired", "Blocked"]}
          }
        },
        "campaign": {
          "type": "object", "additionalProperties": false,
          "required": ["authority_mode", "ai_repair_allowed_with_explicit_authority", "authority_source", "authority_must_bind", "profiles", "scope_manifest", "progress_source", "progress_resets_no_progress_streak", "task_change_resets_streak", "model_change_resets_streak", "chain_change_resets_streak", "hard_stop_flags", "independent_review_after_each_attempt", "delivery_authority_separate"],
          "properties": {
            "authority_mode": {"enum": ["RepairCampaignAuthority"]},
            "ai_repair_allowed_with_explicit_authority": {"const": true},
            "authority_source": {"enum": ["trusted_context_attested_task_bound_campaign_receipt"]},
            "authority_must_bind": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["campaign_id", "task_id", "acceptance_contract_hash", "allowed_scope_hash", "profile", "activation_chain_digest", "activation_history_head_hash"]}, "allOf": [{"contains": {"const": "campaign_id"}}, {"contains": {"const": "task_id"}}, {"contains": {"const": "acceptance_contract_hash"}}, {"contains": {"const": "allowed_scope_hash"}}, {"contains": {"const": "profile"}}, {"contains": {"const": "activation_chain_digest"}}, {"contains": {"const": "activation_history_head_hash"}}]},
            "profiles": {
              "type": "object", "additionalProperties": false, "required": ["core_product", "harness"],
              "properties": {
                "core_product": {"type": "object", "additionalProperties": false, "required": ["max_consecutive_no_progress"], "properties": {"max_consecutive_no_progress": {"type": "integer", "minimum": 1}}},
                "harness": {"type": "object", "additionalProperties": false, "required": ["max_consecutive_no_progress"], "properties": {"max_consecutive_no_progress": {"type": "integer", "minimum": 1}}}
              }
            },
            "scope_manifest": {
              "type": "object", "additionalProperties": false,
              "required": ["exact_files_field", "path_prefixes_field", "require_relative_normalized_paths", "current_chain_files_must_be_subset"],
              "properties": {
                "exact_files_field": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                "path_prefixes_field": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                "require_relative_normalized_paths": {"const": true},
                "current_chain_files_must_be_subset": {"const": true}
              }
            },
            "progress_source": {"enum": ["trusted_context_attested_campaign_state_receipt"]},
            "progress_resets_no_progress_streak": {"const": true},
            "task_change_resets_streak": {"const": false},
            "model_change_resets_streak": {"const": false},
            "chain_change_resets_streak": {"const": false},
            "hard_stop_flags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["p0_finding", "security_boundary_change", "data_integrity_risk", "scope_outside_campaign", "irreversible_action", "external_side_effect", "test_oracle_weakened", "unapproved_dependency_change", "required_evidence_missing"]}, "allOf": [{"contains": {"const": "p0_finding"}}, {"contains": {"const": "security_boundary_change"}}, {"contains": {"const": "data_integrity_risk"}}, {"contains": {"const": "scope_outside_campaign"}}, {"contains": {"const": "irreversible_action"}}, {"contains": {"const": "external_side_effect"}}, {"contains": {"const": "test_oracle_weakened"}}, {"contains": {"const": "unapproved_dependency_change"}}, {"contains": {"const": "required_evidence_missing"}}]},
            "independent_review_after_each_attempt": {"const": true},
            "delivery_authority_separate": {"const": true}
          }
        },
        "mechanical_decisions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["MechanicallyEligible", "Stop", "Blocked"]}},
        "promotion_decisions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["AutoRepairAllowed", "ExtendRound3", "EscalatedRepairAllowed"]}},
        "promotion_requires_trusted_orchestrator": {"const": true},
        "eligible_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["AutoRepair", "ExtendRound3", "EscalatedRepair"]}}
      }
    }
  }
}
