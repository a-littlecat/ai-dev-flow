{
  "adapter_id": "opencode",
  "verified_at": "2026-08-08",
  "skill_loading": "markdown",
  "read_files": true,
  "write_files": true,
  "run_commands": true,
  "git": true,
  "context_isolation": "independent_session",
  "write_isolation": "readonly_copy",
  "subagents": "opaque",
  "approval_gate": "native",
  "runtime_hooks": "plugin",
  "session_events": "adapter",
  "runtime_session_bridge": {
    "type": "command",
    "command": "{python} -B {skill_root}/scripts/adf.py",
    "hooks": {
      "start": "session start --project-root {project_root} --session {session_id} --task {task_id} --harness opencode --phase {phase} --next-step {next_step} --status-summary {status_summary}",
      "update": "session update --project-root {project_root} --session {session_id} --phase {phase} --next-step {next_step} --status-summary {status_summary}",
      "wait": "session wait --project-root {project_root} --session {session_id} --reason {reason}",
      "end": "session end --project-root {project_root} --session {session_id} --reason {reason}",
      "heartbeat": "session heartbeat --project-root {project_root} --session {session_id}"
    }
  },
  "preferred_review_recipe": "R3",
  "fallback_review_recipe": "R5",
  "formal_skill_sync_method": "explicit governed Skill sync only",
  "version_sensitive_notes": "Runtime Session command bridge uses the bundled fail-closed adf.py entry point; OpenCode must invoke the documented lifecycle hooks explicitly."
}
